<Application x:Class="OBD2Suite.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OBD2Suite.ViewModels"
             xmlns:views="clr-namespace:OBD2Suite.Views"
             xmlns:conv="clr-namespace:OBD2Suite.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <conv:BoolToColorConverter              x:Key="BoolToColorConverter"/>
            <conv:BoolToVisibilityConverter         x:Key="BoolToVisibilityConverter"/>
            <conv:InverseBoolToVisibilityConverter  x:Key="InverseBoolToVisibilityConverter"/>
            <conv:ValueToWidthConverter             x:Key="ValueToWidthConverter"/>
            <conv:SeverityToColorConverter          x:Key="SeverityToColorConverter"/>
            <conv:NullToVisibilityConverter         x:Key="NullToVisibilityConverter"/>
            <conv:BoolToSimTextConverter            x:Key="BoolToSimTextConverter"/>
            <conv:HexColorToBrushConverter          x:Key="HexColorToBrushConverter"/>

            <!-- DataTemplates mapping ViewModel → View -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DtcViewModel}">
                <views:DtcView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:VehicleInfoViewModel}">
                <views:VehicleInfoView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CodingViewModel}">
                <views:CodingView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OemFeaturesViewModel}">
                <views:OemFeaturesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReadinessViewModel}">
                <views:ReadinessView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FreezeFrameViewModel}">
                <views:FreezeFrameView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:Mode06ViewModel}">
                <views:Mode06View/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SpecialFunctionsViewModel}">
                <views:SpecialFunctionsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DataLoggerViewModel}">
                <views:DataLoggerView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:VinDecoderViewModel}">
                <views:VinDecoderView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
