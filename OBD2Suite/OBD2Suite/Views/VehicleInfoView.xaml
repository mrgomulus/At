<UserControl x:Class="OBD2Suite.Views.VehicleInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Vehicle Information" FontSize="22" FontWeight="Bold"
                   Foreground="{StaticResource AccentBrush}" Margin="0,0,0,16"/>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="🚗  Scan Vehicle Info" Command="{Binding ScanVehicleCommand}"
                    Style="{StaticResource AccentButtonStyle}" Padding="16,8" Margin="0,0,8,0"/>
            <Button Content="🔌  Scan All ECUs" Command="{Binding ScanEcusCommand}"
                    Style="{StaticResource BaseButtonStyle}" Padding="16,8"/>
            <ProgressBar IsIndeterminate="True" Width="120" Height="4" Margin="16,0,0,0"
                         VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>

        <!-- VIN / Vehicle Summary Card -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                Visibility="{Binding VehicleInfo, Converter={StaticResource NullToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="VIN" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding VehicleInfo.Vin}" Foreground="{StaticResource AccentBrush}"
                               FontFamily="Consolas" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="{Binding VehicleInfo.VinDecoded}" Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Make / Model / Year" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,4"/>
                    <TextBlock Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold">
                        <Run Text="{Binding VehicleInfo.Make}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding VehicleInfo.Model}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding VehicleInfo.Year}"/>
                    </TextBlock>
                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" FontSize="12">
                        <Run Text="{Binding VehicleInfo.EngineType}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding VehicleInfo.TransmissionType}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Calibration / Software" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding VehicleInfo.CalibrationId}" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="Consolas" FontSize="12"/>
                    <TextBlock Text="{Binding VehicleInfo.SoftwareVersion}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ECU Modules Grid -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="ECU Modules" Foreground="{StaticResource AccentBrush}"
                           FontWeight="SemiBold" Margin="16,12,0,8"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding EcuModules}"
                          SelectedItem="{Binding SelectedEcu}"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" Background="Transparent"
                          RowBackground="#0AFFFFFF" AlternatingRowBackground="#05FFFFFF"
                          BorderThickness="0" Foreground="{StaticResource PrimaryTextBrush}"
                          ColumnHeaderHeight="36" RowHeight="32">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2A2A3E"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="12,0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Address"  Binding="{Binding AddressHex}"       Width="80"/>
                        <DataGridTextColumn Header="Name"     Binding="{Binding Name}"             Width="*"/>
                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}"         Width="160"/>
                        <DataGridTextColumn Header="Part No." Binding="{Binding PartNumber}"       Width="120"/>
                        <DataGridTextColumn Header="SW Ver."  Binding="{Binding SoftwareVersion}"  Width="80"/>
                        <DataGridTextColumn Header="HW Ver."  Binding="{Binding HardwareVersion}"  Width="80"/>
                        <DataGridTextColumn Header="Coding"   Binding="{Binding LongCodingString}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Status -->
        <Border Grid.Row="4" Background="#1A00D4FF" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="Consolas" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
