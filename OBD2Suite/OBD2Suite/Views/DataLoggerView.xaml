<UserControl x:Class="OBD2Suite.Views.DataLoggerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📊 LIVE DATA LOGGER" Style="{StaticResource HeadingText}" Margin="0,0,0,16"/>

        <!-- Controls toolbar -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="⏺ Start Recording" Command="{Binding StartCommand}"
                        Style="{StaticResource SuccessButton}" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="⏹ Stop" Command="{Binding StopCommand}"
                        Style="{StaticResource DangerButton}" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="💾 Export CSV" Command="{Binding ExportCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,16,0"/>
                <Button Grid.Column="3" Content="🗑 Clear" Command="{Binding ClearCommand}"
                        Style="{StaticResource GhostButton}" Margin="0,0,16,0"/>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Interval (ms):" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider Value="{Binding IntervalMs}" Minimum="200" Maximum="5000"
                            Width="120" VerticalAlignment="Center" Margin="0,0,8,0"
                            IsSnapToTickEnabled="True" TickFrequency="100"/>
                    <TextBlock Text="{Binding IntervalMs, StringFormat='{}{0} ms'}"
                               Foreground="{StaticResource InfoBrush}" FontFamily="Consolas"
                               VerticalAlignment="Center" Width="60"/>
                </StackPanel>

                <!-- Status indicator -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#444"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock VerticalAlignment="Center" FontSize="12" FontFamily="Consolas">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Stopped"/>
                                <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="Text" Value="● REC"/>
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding SampleCount, StringFormat='  {0} samples'}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas"
                               FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ElapsedSeconds, StringFormat='  {0:F1} s'}"
                               Foreground="{StaticResource InfoBrush}" FontFamily="Consolas"
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Live log -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource SubheadingText}" Text="LIVE LOG" Margin="0,0,0,8"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LiveEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Saved sessions -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource SubheadingText}" Text="SAVED SESSIONS" Margin="0,0,0,8"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding SavedSessions}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="Transparent" AlternatingRowBackground="#0AFFFFFF"
                          Foreground="{StaticResource TextPrimaryBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Session Name"  Binding="{Binding SessionName}"   Width="*"   IsReadOnly="True"/>
                        <DataGridTextColumn Header="Started"       Binding="{Binding StartedAt, StringFormat='dd.MM.yyyy HH:mm:ss'}" Width="160" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Duration"      Binding="{Binding DurationText}"  Width="180" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Interval"      Binding="{Binding IntervalMs, StringFormat='{}{0} ms'}" Width="80" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
