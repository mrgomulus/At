<UserControl x:Class="OBD2Suite.Views.ReadinessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="📋 I/M READINESS MONITORS" Style="{StaticResource HeadingText}"/>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="🔍 Read Monitors" Command="{Binding ReadCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding StatusMessage}" FontFamily="Consolas" FontSize="12"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="6" Margin="12,0,0,0"
                             VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </StackPanel>
        </Border>

        <!-- Results -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Summary card -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0"
                    Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingText}" Text="SUMMARY" Margin="0,0,0,16"/>
                    <Border CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#33FF5252"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Report.IsReadyForTest}" Value="True">
                                        <Setter Property="Background" Value="#334CAF50"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Report.OverallStatus}" TextWrapping="Wrap"
                                   FontWeight="Bold" FontSize="14" TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Report.IsReadyForTest}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="MIL (Check Engine):" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="OFF ✔"/>
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Report.MilOn}" Value="True">
                                            <Setter Property="Text" Value="ON ✖"/>
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="DTCs in memory:" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Report.DtcCount}" HorizontalAlignment="Right"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Grid>

                    <TextBlock Margin="0,16,0,4" Text="Read at:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    <TextBlock Text="{Binding Report.ReadAt, StringFormat='dd.MM.yyyy HH:mm:ss'}"
                               Foreground="{StaticResource InfoBrush}" FontFamily="Consolas" FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- Monitor list -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}"
                    Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource SubheadingText}" Text="MONITOR STATUS" Margin="0,0,0,12"/>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Report.Monitors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,3" Padding="12,10" CornerRadius="6"
                                        Background="{StaticResource SurfaceVariantBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="14">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="⊙"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsContinuous}" Value="True">
                                                            <Setter Property="Text" Value="🔄"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1" Margin="8,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding IsContinuous, Converter={StaticResource BoolToSimTextConverter}}"
                                                   FontSize="10" Margin="0,0,12,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextDisabledBrush}"/>
                                        <Border Grid.Column="3" CornerRadius="4" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Border.Background>
                                                <Binding Path="StatusColor" Converter="{StaticResource HexColorToBrushConverter}"/>
                                            </Border.Background>
                                            <TextBlock Text="{Binding StatusText}" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Empty state -->
            <Border Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}"
                    Visibility="{Binding HasReport, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="Click 'Read Monitors' to check I/M Readiness status."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Use this to determine if your vehicle is ready for an emissions test."
                               Foreground="{StaticResource TextDisabledBrush}" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Mode 06 hint -->
        <TextBlock Grid.Row="3" Margin="0,8,0,0" FontSize="11"
                   Foreground="{StaticResource TextDisabledBrush}"
                   Text="🔬 Continuous monitors (🔄) run at all times. Non-continuous monitors require a full drive cycle to complete."/>
    </Grid>
</UserControl>
