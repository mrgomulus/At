<UserControl x:Class="OBD2Suite.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Connection Settings" FontSize="22" FontWeight="Bold"
                   Foreground="{StaticResource AccentBrush}" Margin="0,0,0,20"/>

        <!-- Connection Form -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- COM Port -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,12">
                    <TextBlock Text="COM Port" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding AvailablePorts}"
                                  SelectedItem="{Binding SelectedPort}"
                                  Style="{StaticResource BaseComboBoxStyle}"/>
                        <Button Grid.Column="1" Content="↺" Command="{Binding RefreshPortsCommand}"
                                Style="{StaticResource BaseButtonStyle}" Padding="8,6" Margin="4,0,0,0"
                                ToolTip="Refresh COM ports"/>
                    </Grid>
                </StackPanel>

                <!-- Baud Rate -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,16,12">
                    <TextBlock Text="Baud Rate" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding BaudRates}"
                              SelectedItem="{Binding SelectedBaudRate}"
                              Style="{StaticResource BaseComboBoxStyle}"/>
                </StackPanel>

                <!-- Protocol -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="Protocol" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Protocols}"
                              SelectedItem="{Binding SelectedProtocol}"
                              Style="{StaticResource BaseComboBoxStyle}"/>
                </StackPanel>

                <!-- Simulation Mode -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,16">
                    <CheckBox IsChecked="{Binding SimulationMode}"
                              Foreground="{StaticResource PrimaryTextBrush}"
                              VerticalAlignment="Center">
                        <TextBlock Text="Simulation Mode (no hardware required)" Foreground="{StaticResource PrimaryTextBrush}"/>
                    </CheckBox>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
                    <Button Content="Connect" Command="{Binding ConnectCommand}"
                            Style="{StaticResource AccentButtonStyle}" Width="130" Margin="0,0,12,0"/>
                    <Button Content="Disconnect" Command="{Binding DisconnectCommand}"
                            Style="{StaticResource BaseButtonStyle}" Width="130"/>
                </StackPanel>

                <!-- ELM Info -->
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0"
                            Visibility="{Binding ElmInfo, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="Device Info" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ElmInfo}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas"/>
                </StackPanel>

                <!-- Status -->
                <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0"
                        Background="#1A00D4FF" BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="0,0,0,0" CornerRadius="6" Padding="12,8">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>

        <!-- Tips -->
        <Border Grid.Row="2" Background="#0AFFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,0">
            <StackPanel>
                <TextBlock Text="💡 Quick Start" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12">
                    1. Enable Simulation Mode to explore all features without an OBD adapter.&#x0a;
                    2. For real vehicle diagnostics: connect an ELM327 USB/Bluetooth adapter, select the COM port, and click Connect.&#x0a;
                    3. Typical baud rate for ELM327: 38400. Some clones may need 9600 or 115200.&#x0a;
                    4. Protocol "Auto" lets the ELM327 detect the vehicle protocol automatically.
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
