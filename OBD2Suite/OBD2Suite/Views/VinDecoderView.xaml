<UserControl x:Class="OBD2Suite.Views.VinDecoderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="🔎 VIN DECODER (ISO 3779)"
                   Style="{StaticResource HeadingText}" Margin="0,0,0,16"/>

        <!-- Input row -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding VinInput, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="17" FontFamily="Consolas" FontSize="18" Height="40"
                         Background="#1AFFFFFF" Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                         VerticalContentAlignment="Center" Padding="12,0"
                         CharacterCasing="Upper"
                         ToolTip="Enter 17-character VIN (Vehicle Identification Number)"/>
                <Button Grid.Column="1" Content="🔎 Decode VIN" Command="{Binding DecodeCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Height="40" Padding="20,0"/>
            </Grid>
        </Border>

        <!-- Decode result -->
        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource SubheadingText}" Text="DECODE RESULT" Margin="0,0,0,12"/>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding DecodeFields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,8" Margin="0,2" CornerRadius="6"
                                    Background="{StaticResource SurfaceVariantBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Item1}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Item2}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"
                                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- VIN structure diagram -->
        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SubheadingText}" Text="VIN STRUCTURE" Margin="0,0,0,16"/>

                <Border Background="{StaticResource SurfaceVariantBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                    <TextBlock FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding VinInput}" TextAlignment="Center"/>
                </Border>

                <StackPanel>
                    <Border Margin="0,0,0,8" Padding="12,8" CornerRadius="6" Background="#1A1565C0">
                        <StackPanel>
                            <TextBlock Text="WMI — World Manufacturer Identifier"
                                       Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="Positions 1–3: Identifies manufacturer and country"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding Result.Manufacturer}"
                                       Foreground="{StaticResource InfoBrush}" FontFamily="Consolas" FontSize="13"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,0,8" Padding="12,8" CornerRadius="6" Background="#1AFF6F00">
                        <StackPanel>
                            <TextBlock Text="VDS — Vehicle Descriptor Section"
                                       Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="Positions 4–9: Vehicle attributes + check digit (pos 9)"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding Result.Vds}"
                                       Foreground="{StaticResource InfoBrush}" FontFamily="Consolas" FontSize="13"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,0,8" Padding="12,8" CornerRadius="6" Background="#1A4CAF50">
                        <StackPanel>
                            <TextBlock Text="VIS — Vehicle Identifier Section"
                                       Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="Positions 10–17: Model year, plant, serial number"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding Result.Vis}"
                                       Foreground="{StaticResource InfoBrush}" FontFamily="Consolas" FontSize="13"/>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Model Year:"      Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Result.ModelYear}"  FontFamily="Consolas" HorizontalAlignment="Right" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Assembly Plant:"  Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Result.PlantName}"  FontFamily="Consolas" HorizontalAlignment="Right" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Serial Number:"   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Result.SerialNumber}" FontFamily="Consolas" HorizontalAlignment="Right" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
