<UserControl x:Class="OBD2Suite.Views.OemFeaturesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Manufacturer-Specific Functions" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="VAG · BMW · Mercedes · Ford · Toyota · GM · PSA · Fiat · Renault + more"
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Manufacturer + ECU Selection -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Manufacturer" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AllManufacturers}"
                              SelectedItem="{Binding SelectedManufacturer}"
                              Style="{StaticResource BaseComboBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="ECU Module" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding EcuModules}"
                              SelectedItem="{Binding SelectedEcu}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource BaseComboBoxStyle}"/>
                </StackPanel>

                <Button Grid.Column="2" Content="🔌 Scan ECUs" Command="{Binding ScanEcusCommand}"
                        Style="{StaticResource AccentButtonStyle}" Padding="14,6" Margin="0,0,8,0" VerticalAlignment="Bottom"/>
                <ProgressBar Grid.Column="3" IsIndeterminate="True" Width="80" Height="4" VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <!-- Main content area — TabControl -->
        <TabControl Grid.Row="2" Background="Transparent"
                    BorderBrush="#3A3A5C" BorderThickness="0,1,0,0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                    <Setter Property="Padding" Value="16,8"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Background" Value="#1A00D4FF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- ── Fault Codes ────────────────────────────────────────── -->
            <TabItem Header="🔴 OEM Fault Codes">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Read Fault Codes" Command="{Binding ReadOemDtcsCommand}"
                                Style="{StaticResource AccentButtonStyle}" Padding="14,7" Margin="0,0,8,0"/>
                        <Button Content="Clear Fault Codes" Command="{Binding ClearOemDtcsCommand}"
                                Style="{StaticResource DangerButtonStyle}" Padding="14,7"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding OemDtcList}"
                             Background="#0A000000" BorderBrush="#3A3A5C"
                             Foreground="{StaticResource PrimaryTextBrush}" FontFamily="Consolas" FontSize="12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="4,3" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- ── Measuring Blocks ──────────────────────────────────── -->
            <TabItem Header="📊 Measuring Blocks">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Group #:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding AvailableGroups}"
                                  SelectedItem="{Binding SelectedMeasuringGroup}"
                                  Width="80" Style="{StaticResource BaseComboBoxStyle}" Margin="0,0,12,0"/>
                        <Button Content="Read Block" Command="{Binding ReadMeasuringBlockCommand}"
                                Style="{StaticResource AccentButtonStyle}" Padding="14,7"/>
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                        <DataGrid ItemsSource="{Binding MeasuringBlocks}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" Background="Transparent"
                                  RowBackground="#0AFFFFFF" AlternatingRowBackground="#05FFFFFF"
                                  BorderThickness="0" Foreground="{StaticResource PrimaryTextBrush}"
                                  ColumnHeaderHeight="32" RowHeight="28">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#2A2A3E"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="12,0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding Fields}" Margin="8">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1A00D4FF" CornerRadius="6" Margin="4" Padding="10,6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/>
                                                        <TextBlock Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontWeight="Bold">
                                                            <Run Text="{Binding Value}"/>
                                                            <Run Text=" "/>
                                                            <Run Text="{Binding Unit}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Group" Binding="{Binding GroupNumber}" Width="60"/>
                                <DataGridTextColumn Header="Name"  Binding="{Binding Name}"        Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ── Actuator Tests ────────────────────────────────────── -->
            <TabItem Header="⚡ Actuator Tests">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Load Tests" Command="{Binding LoadActuatorTestsCommand}"
                                    Style="{StaticResource AccentButtonStyle}" Padding="14,7" Margin="0,0,8,0"/>
                            <Button Content="▶ Run Selected" Command="{Binding RunActuatorTestCommand}"
                                    Style="{StaticResource DangerButtonStyle}" Padding="14,7"/>
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                            <DataGrid ItemsSource="{Binding ActuatorTests}"
                                      SelectedItem="{Binding SelectedTest}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal" Background="Transparent"
                                      RowBackground="#0AFFFFFF" AlternatingRowBackground="#05FFFFFF"
                                      BorderThickness="0" Foreground="{StaticResource PrimaryTextBrush}"
                                      ColumnHeaderHeight="32" RowHeight="32">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#2A2A3E"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="12,0"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name"       Binding="{Binding Name}"        Width="*"/>
                                    <DataGridTextColumn Header="Category"   Binding="{Binding Category}"    Width="100"/>
                                    <DataGridTextColumn Header="Status"     Binding="{Binding StatusText}"  Width="120"/>
                                    <DataGridTextColumn Header="Last Result" Binding="{Binding LastResult}" Width="160"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <!-- Test detail panel -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}"
                            Visibility="{Binding SelectedTest, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedTest.Name}" Foreground="{StaticResource AccentBrush}"
                                       FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding SelectedTest.Description}" Foreground="{StaticResource PrimaryTextBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding SelectedTest.Category}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                            <Separator Background="#3A3A5C" Margin="0,12"/>
                            <TextBlock Text="Status:" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding SelectedTest.StatusText}" Foreground="{StaticResource AccentBrush}"
                                       FontWeight="Bold" FontSize="14" Margin="0,4,0,12"/>
                            <Button Content="▶ Run This Test" Command="{Binding RunActuatorTestCommand}"
                                    Style="{StaticResource DangerButtonStyle}" Padding="14,8"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ── ECU Coding ─────────────────────────────────────────── -->
            <TabItem Header="🔧 OEM Coding">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Read Coding" Command="{Binding ReadCodingCommand}"
                                Style="{StaticResource AccentButtonStyle}" Padding="14,7" Margin="0,0,8,0"/>
                        <Button Content="Read Identification" Command="{Binding ReadIdentificationCommand}"
                                Style="{StaticResource BaseButtonStyle}" Padding="14,7" Margin="0,0,8,0"/>
                        <Button Content="Reset Service Interval" Command="{Binding ResetServiceIntervalCommand}"
                                Style="{StaticResource DangerButtonStyle}" Padding="14,7" Margin="0,0,8,0"/>
                        <Button Content="Throttle Basic Setting" Command="{Binding ThrottleBasicSettingCommand}"
                                Style="{StaticResource DangerButtonStyle}" Padding="14,7" Margin="0,0,8,0"/>
                        <Button Content="Steering Calibration" Command="{Binding SteeringCalibrationCommand}"
                                Style="{StaticResource DangerButtonStyle}" Padding="14,7"/>
                    </StackPanel>

                    <!-- ECU Identification info -->
                    <Border Grid.Row="1" Background="#0A00D4FF" BorderBrush="#2A00D4FF"
                            BorderThickness="1" CornerRadius="6" Margin="0,0,0,12"
                            Visibility="{Binding EcuIdentInfo, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBox Text="{Binding EcuIdentInfo, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11" Background="Transparent"
                                 Foreground="{StaticResource PrimaryTextBrush}" BorderThickness="0"
                                 Padding="12,8" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto"/>
                    </Border>

                    <!-- Activity log -->
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Activity Log" Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold" Margin="16,12,0,8"/>
                            <TextBox Grid.Row="1" Text="{Binding OutputLog, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="11" Background="Transparent"
                                     Foreground="{StaticResource SecondaryTextBrush}"
                                     BorderThickness="0" Padding="16,8"
                                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#1A00D4FF" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="Consolas" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
