<UserControl x:Class="OBD2Suite.Views.Mode06View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🔬 ON-BOARD MONITORING TESTS (MODE 06)" Style="{StaticResource HeadingText}" Margin="0,0,0,16"/>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="🔬 Read Tests" Command="{Binding ReadCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding StatusMessage}" FontFamily="Consolas" FontSize="12"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="6" Margin="12,0,0,0" VerticalAlignment="Center"
                             Foreground="{StaticResource AccentBrush}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <DataGrid ItemsSource="{Binding Tests}"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      Background="Transparent" BorderThickness="0"
                      RowBackground="Transparent" AlternatingRowBackground="#0AFFFFFF"
                      Foreground="{StaticResource TextPrimaryBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Test ID"    Binding="{Binding TestId}"          Width="70"  IsReadOnly="True"/>
                    <DataGridTextColumn Header="Name"       Binding="{Binding Name}"             Width="*"   IsReadOnly="True"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}"     Width="*"   IsReadOnly="True"/>
                    <DataGridTextColumn Header="Measured"   Binding="{Binding MeasuredValue, StringFormat='{}{0:F3}'}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Min"        Binding="{Binding MinLimit}"         Width="70"  IsReadOnly="True"/>
                    <DataGridTextColumn Header="Max"        Binding="{Binding MaxLimit}"         Width="70"  IsReadOnly="True"/>
                    <DataGridTextColumn Header="Unit"       Binding="{Binding Unit}"             Width="70"  IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Result" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" Margin="4">
                                    <Border.Background>
                                        <Binding Path="ResultColor" Converter="{StaticResource HexColorToBrushConverter}"/>
                                    </Border.Background>
                                    <TextBlock Text="{Binding ResultText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
