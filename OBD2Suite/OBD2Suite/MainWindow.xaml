<Window x:Class="OBD2Suite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OBD2Suite — Professional Diagnostic Tool"
        Height="900" Width="1400"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="48"/>
            <RowDefinition/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryGradientBrush}" Effect="{StaticResource CardShadow}">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Logo and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" Background="#20FFFFFF" CornerRadius="8" Margin="0,0,12,0">
                        <TextBlock Text="⚙" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OBD2Suite" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Professional Diagnostic Tool" FontSize="10" Foreground="#99FFFFFF"/>
                    </StackPanel>
                </StackPanel>

                <!-- Connection Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Ellipse x:Name="ConnStatusDot" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock x:Name="ConnStatusText" VerticalAlignment="Center" Foreground="White" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Disconnected"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Text" Value="Connected"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ConnectionInfo}" Foreground="#99FFFFFF" FontSize="11"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Connect/Disconnect Button -->
                <Button Grid.Column="3" x:Name="BtnConnect"
                        Command="{Binding ConnectCommand}"
                        VerticalAlignment="Center"
                        Padding="16,8"
                        FontSize="13">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                            <Setter Property="Content" Value="Connect"/>
                            <Setter Property="Background" Value="{StaticResource SuccessGradientBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Content" Value="Disconnect"/>
                                    <Setter Property="Background" Value="{StaticResource ErrorGradientBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Navigation Tabs -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="8,0">
                <RadioButton Content="📊 Dashboard" Style="{StaticResource TabButtonStyle}"
                             IsChecked="{Binding IsDashboardActive}"
                             Command="{Binding NavigateToDashboardCommand}"/>
                <RadioButton Content="🔴 Fault Codes" Style="{StaticResource TabButtonStyle}"
                             IsChecked="{Binding IsDtcActive}"
                             Command="{Binding NavigateToDtcCommand}"/>
                <RadioButton Content="📈 Live Data" Style="{StaticResource TabButtonStyle}"
                             IsChecked="{Binding IsLiveDataActive}"
                             Command="{Binding NavigateToLiveDataCommand}"/>
                <RadioButton Content="🚗 Vehicle Info" Style="{StaticResource TabButtonStyle}"
                             IsChecked="{Binding IsVehicleInfoActive}"
                             Command="{Binding NavigateToVehicleInfoCommand}"/>
                <RadioButton Content="🔧 ECU Modules" Style="{StaticResource TabButtonStyle}"
                             IsChecked="{Binding IsEcuModulesActive}"
                             Command="{Binding NavigateToEcuModulesCommand}"/>
                <RadioButton Content="⚙ Settings" Style="{StaticResource TabButtonStyle}"
                             IsChecked="{Binding IsSettingsActive}"
                             Command="{Binding NavigateToSettingsCommand}"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <!-- Loading Overlay -->
            <Border x:Name="LoadingOverlay"
                    Background="#AA000000"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"
                    Panel.ZIndex="100">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="⌛" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="{Binding BusyMessage}" FontSize="16"
                               HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Dashboard View -->
            <ScrollViewer Visibility="{Binding IsDashboardActive, Converter={StaticResource BoolToVisConverter}}"
                          VerticalScrollBarVisibility="Auto" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Vehicle Summary Card -->
                    <Border Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SubheadingText}" Text="VEHICLE SUMMARY" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource HeadingText}"
                                               Text="{Binding VehicleInfo.Year, StringFormat='{}{0} ', FallbackValue='-- '}"/>
                                    <TextBlock Style="{StaticResource HeadingText}"
                                               Text="{Binding VehicleInfo.Make, FallbackValue='No Vehicle'}"/>
                                    <TextBlock Style="{StaticResource HeadingText}"
                                               Text="{Binding VehicleInfo.Model, StringFormat=' {0}', FallbackValue=''}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="VIN: " Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Style="{StaticResource MonoText}"
                                               Text="{Binding VehicleInfo.Vin, FallbackValue='Not Available'}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding VehicleInfo.EngineType, FallbackValue=''}"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <Border Background="{Binding DtcCount, Converter={StaticResource DtcCountToBrushConverter}}"
                                        CornerRadius="8" Padding="16,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding DtcCount}" FontSize="32" FontWeight="Bold"
                                                   HorizontalAlignment="Center" Foreground="White"/>
                                        <TextBlock Text="Fault Codes" FontSize="11" HorizontalAlignment="Center"
                                                   Foreground="#CCFFFFFF"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- RPM Gauge Card -->
                    <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,6,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubheadingText}" Text="ENGINE RPM" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource ValueText}"
                                       Text="{Binding EngineRpm, StringFormat='{}{0:F0} rpm'}"
                                       FontSize="28" HorizontalAlignment="Center"/>
                            <ProgressBar Value="{Binding EngineRpm}" Maximum="8000" Height="8" Margin="0,8,0,0"
                                         Foreground="{StaticResource PrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                <TextBlock Text="8000" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"
                                           HorizontalAlignment="Right" Margin="0,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Speed Gauge Card -->
                    <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="6,0,6,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubheadingText}" Text="VEHICLE SPEED" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource ValueText}"
                                       Text="{Binding VehicleSpeed, StringFormat='{}{0:F0} km/h'}"
                                       FontSize="28" HorizontalAlignment="Center"/>
                            <ProgressBar Value="{Binding VehicleSpeed}" Maximum="255" Height="8" Margin="0,8,0,0"
                                         Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Coolant Temp Card -->
                    <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="6,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubheadingText}" Text="COOLANT TEMP" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource ValueText}"
                                       Text="{Binding CoolantTemp, StringFormat='{}{0:F1} °C'}"
                                       FontSize="28" HorizontalAlignment="Center"/>
                            <ProgressBar Value="{Binding CoolantTemp}" Minimum="-40" Maximum="215" Height="8" Margin="0,8,0,0"
                                         Foreground="{StaticResource InfoBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Quick Stats Row -->
                    <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <!-- Throttle -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource SubheadingText}" Text="THROTTLE" HorizontalAlignment="Center"/>
                                <TextBlock Style="{StaticResource ValueText}"
                                           Text="{Binding ThrottlePosition, StringFormat='{}{0:F1}%'}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            <!-- Fuel Level -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource SubheadingText}" Text="FUEL LEVEL" HorizontalAlignment="Center"/>
                                <TextBlock Style="{StaticResource ValueText}"
                                           Text="{Binding FuelLevel, StringFormat='{}{0:F1}%'}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            <!-- Battery Voltage -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource SubheadingText}" Text="BATTERY" HorizontalAlignment="Center"/>
                                <TextBlock Style="{StaticResource ValueText}"
                                           Text="{Binding BatteryVoltage, StringFormat='{}{0:F2} V'}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            <!-- Engine Load -->
                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource SubheadingText}" Text="ENGINE LOAD" HorizontalAlignment="Center"/>
                                <TextBlock Style="{StaticResource ValueText}"
                                           Text="{Binding EngineLoad, StringFormat='{}{0:F1}%'}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- DTC View -->
            <Grid Visibility="{Binding IsDtcActive, Converter={StaticResource BoolToVisConverter}}" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- DTC Toolbar -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Diagnostic Trouble Codes" Style="{StaticResource HeadingText}" Margin="0,0,12,0"/>
                            <Border Background="{StaticResource ErrorBrush}" CornerRadius="10" Padding="8,2"
                                    Visibility="{Binding HasDtcs, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="{Binding DtcCount, StringFormat='{}{0} codes'}"
                                           Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1" Content="🔍 Scan" Command="{Binding ReadDtcsCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="🗑 Clear All" Command="{Binding ClearDtcsCommand}"
                                Style="{StaticResource DangerButton}" Margin="0,0,8,0"
                                IsEnabled="{Binding HasDtcs}"/>
                        <ComboBox Grid.Column="3" Width="140"
                                  ItemsSource="{Binding DtcFilterOptions}"
                                  SelectedItem="{Binding SelectedDtcFilter}"/>
                    </Grid>
                </Border>

                <!-- DTC List -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding FilteredDtcs}"
                          SelectedItem="{Binding SelectedDtc}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#05FFFFFF">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Code" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Code}" Style="{StaticResource MonoText}"
                                               FontWeight="Bold" Foreground="{StaticResource InfoBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Severity" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SeverityText}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SeverityText}" Value="Critical">
                                                        <Setter Property="Foreground" Value="{StaticResource CriticalBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SeverityText}" Value="Severe">
                                                        <Setter Property="Foreground" Value="{StaticResource SevereBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SeverityText}" Value="Moderate">
                                                        <Setter Property="Foreground" Value="{StaticResource ModerateBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SeverityText}" Value="Minor">
                                                        <Setter Property="Foreground" Value="{StaticResource MinorBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SeverityText}" Value="Info">
                                                        <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="90"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                        <DataGridTextColumn Header="ECU Source" Binding="{Binding EcuSource}" Width="120"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        <DataGridTemplateColumn Header="MIL" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IsMilOn, Converter={StaticResource BoolToMilConverter}}"
                                               HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="First Seen" Binding="{Binding FirstSeen, StringFormat='{}{0:MM/dd HH:mm}'}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Freeze Frame Details -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,8,0,0"
                        Visibility="{Binding SelectedDtcHasFreezeFrame, Converter={StaticResource BoolToVisConverter}}">
                    <Expander Header="❄ Freeze Frame Data" Foreground="{StaticResource TextPrimaryBrush}">
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SubheadingText}" Text="ENGINE RPM"/>
                                <TextBlock Style="{StaticResource ValueText}"
                                           Text="{Binding SelectedDtc.FreezeFrame.EngineRpm, StringFormat='{}{0:F0} rpm'}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource SubheadingText}" Text="VEHICLE SPEED"/>
                                <TextBlock Style="{StaticResource ValueText}"
                                           Text="{Binding SelectedDtc.FreezeFrame.VehicleSpeed, StringFormat='{}{0:F0} km/h'}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource SubheadingText}" Text="COOLANT TEMP"/>
                                <TextBlock Style="{StaticResource ValueText}"
                                           Text="{Binding SelectedDtc.FreezeFrame.CoolantTemp, StringFormat='{}{0:F1} °C'}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Style="{StaticResource SubheadingText}" Text="THROTTLE POS"/>
                                <TextBlock Style="{StaticResource ValueText}"
                                           Text="{Binding SelectedDtc.FreezeFrame.ThrottlePosition, StringFormat='{}{0:F1}%'}"/>
                            </StackPanel>
                        </Grid>
                    </Expander>
                </Border>
            </Grid>

            <!-- Live Data View -->
            <Grid Visibility="{Binding IsLiveDataActive, Converter={StaticResource BoolToVisConverter}}" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!-- Live Data Toolbar -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Live Data Parameters" Style="{StaticResource HeadingText}" Margin="0,0,16,0"/>
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextDisabledBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPolling}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding IsPolling, Converter={StaticResource BoolToPollingTextConverter}}"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="📡 Read Once" Command="{Binding ReadLiveDataCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                        <Button Grid.Column="2"
                                Command="{Binding TogglePollingCommand}"
                                Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                    <Setter Property="Content" Value="▶ Start Polling"/>
                                    <Setter Property="Background" Value="{StaticResource SuccessGradientBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPolling}" Value="True">
                                            <Setter Property="Content" Value="⏹ Stop Polling"/>
                                            <Setter Property="Background" Value="{StaticResource ErrorGradientBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <ComboBox Grid.Column="3" Width="140"
                                  ItemsSource="{Binding PidCategoryFilters}"
                                  SelectedItem="{Binding SelectedPidCategory}"/>
                    </Grid>
                </Border>

                <!-- Live Data Grid -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding FilteredLiveData}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#05FFFFFF">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Parameter" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="PID" Binding="{Binding PidHex}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/>
                        <DataGridTemplateColumn Header="Value" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayValue}"
                                               FontFamily="Consolas" FontWeight="SemiBold"
                                               Foreground="{StaticResource InfoBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Level" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ProgressBar Value="{Binding NormalizedValue}" Maximum="1"
                                                 Height="6" Margin="0,4"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Min" Binding="{Binding MinValue}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Max" Binding="{Binding MaxValue}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Vehicle Info View -->
            <ScrollViewer Visibility="{Binding IsVehicleInfoActive, Converter={StaticResource BoolToVisConverter}}"
                          VerticalScrollBarVisibility="Auto" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!-- Toolbar -->
                    <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}"
                            Margin="0,0,0,12" Padding="12,8">
                        <Grid>
                            <TextBlock Text="Vehicle Information" Style="{StaticResource HeadingText}"/>
                            <Button HorizontalAlignment="Right" Content="🔍 Read Info"
                                    Command="{Binding ReadVehicleInfoCommand}"
                                    Style="{StaticResource PrimaryButton}"/>
                        </Grid>
                    </Border>

                    <!-- VIN Card -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubheadingText}" Text="IDENTIFICATION" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="VIN:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding VehicleInfo.Vin}" Style="{StaticResource MonoText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Make:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VehicleInfo.Make}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Model:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VehicleInfo.Model}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Year:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding VehicleInfo.Year}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Engine:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding VehicleInfo.EngineType}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Trans:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding VehicleInfo.TransmissionType}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="VIN Decoded:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding VehicleInfo.VinDecoded}" Style="{StaticResource MonoText}" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ECU Info Card -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubheadingText}" Text="ECU INFORMATION" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="ECU Name:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding VehicleInfo.EcuName}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Software Version:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VehicleInfo.SoftwareVersion}" Style="{StaticResource MonoText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Calibration ID:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VehicleInfo.CalibrationId}" Style="{StaticResource MonoText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Cal. Verification:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding VehicleInfo.CalibrationVerificationNumber}" Style="{StaticResource MonoText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="ELM Version:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ElmVersion}" Style="{StaticResource MonoText}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- ECU Modules View -->
            <Grid Visibility="{Binding IsEcuModulesActive, Converter={StaticResource BoolToVisConverter}}" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!-- ECU List Header -->
                <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource CardStyle}"
                        Margin="0,0,8,8" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ECU Modules" Style="{StaticResource HeadingText}" VerticalAlignment="Center"/>
                        <Button Content="↻" Style="{StaticResource IconButton}" Margin="8,0,0,0"
                                Command="{Binding ReadEcuModulesCommand}" FontSize="16"/>
                    </StackPanel>
                </Border>

                <!-- ECU Module Details Header -->
                <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource CardStyle}"
                        Margin="8,0,0,8" Padding="12,8">
                    <TextBlock Text="Module Details" Style="{StaticResource HeadingText}"/>
                </Border>

                <!-- ECU Module List -->
                <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <ListBox ItemsSource="{Binding EcuModules}"
                             SelectedItem="{Binding SelectedEcuModule}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,10" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,10,0"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReachable}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding AddressHex}" Style="{StaticResource MonoText}"
                                                           FontSize="11" Foreground="{StaticResource InfoBrush}"/>
                                                <TextBlock Text=" — " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding Protocol}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- ECU Module Details -->
                <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Visibility="{Binding SelectedEcuModule, Converter={StaticResource NullToVisConverter}}">
                            <!-- Module Info -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="26"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Variant:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedEcuModule.Variant}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Part Number:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEcuModule.PartNumber}" Style="{StaticResource MonoText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Software Ver:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedEcuModule.SoftwareVersion}" Style="{StaticResource MonoText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Hardware Ver:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedEcuModule.HardwareVersion}" Style="{StaticResource MonoText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Coding (Hex):" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedEcuModule.CodingHex}" Style="{StaticResource MonoText}"
                                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Long Coding:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedEcuModule.LongCodingString}" Style="{StaticResource MonoText}"
                                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            </Grid>

                            <Separator/>

                            <!-- Adaptation Channels -->
                            <TextBlock Style="{StaticResource SubheadingText}" Text="ADAPTATION CHANNELS" Margin="0,8,0,8"/>
                            <DataGrid ItemsSource="{Binding SelectedEcuModule.AdaptationChannels}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      Background="Transparent" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ch#" Binding="{Binding ChannelNumber}" Width="45"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Current" Binding="{Binding CurrentValue}" Width="80"/>
                                    <DataGridTemplateColumn Header="New Value" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="{StaticResource SurfaceVariantBrush}"
                                                         Foreground="{StaticResource AccentBrush}"
                                                         BorderThickness="1" Padding="4,2"
                                                         FontFamily="Consolas"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="55"/>
                                    <DataGridTextColumn Header="Min" Binding="{Binding MinValue}" Width="55"/>
                                    <DataGridTextColumn Header="Max" Binding="{Binding MaxValue}" Width="60"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Settings View -->
            <ScrollViewer Visibility="{Binding IsSettingsActive, Converter={StaticResource BoolToVisConverter}}"
                          VerticalScrollBarVisibility="Auto" Padding="16">
                <Grid MaxWidth="700">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Settings" Style="{StaticResource HeadingText}" Margin="0,0,0,16"/>

                    <!-- Connection Settings -->
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubheadingText}" Text="CONNECTION" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="40"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Simulation Mode:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding IsSimulationMode}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="COM Port:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailablePorts}"
                                          SelectedItem="{Binding SelectedPort}" Width="160" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Baud Rate:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding BaudRates}"
                                          SelectedItem="{Binding SelectedBaudRate}" Width="160" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Protocol:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Protocols}"
                                          SelectedItem="{Binding SelectedProtocol}" Width="200" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Timeout (ms):" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ConnectionTimeout}"
                                         Width="100" HorizontalAlignment="Left"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Polling Settings -->
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubheadingText}" Text="POLLING" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="40"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Poll Interval (ms):" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                    <Slider Value="{Binding PollInterval}" Minimum="100" Maximum="5000"
                                            Width="200" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PollInterval, StringFormat='{}{0} ms'}"
                                               Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource InfoBrush}" FontFamily="Consolas"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Auto-Start Polling:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding AutoStartPolling}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- About -->
                    <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubheadingText}" Text="ABOUT" Margin="0,0,0,12"/>
                            <TextBlock Text="OBD2Suite — Professional Automotive Diagnostic Tool" FontWeight="SemiBold"/>
                            <TextBlock Text="Version 1.0.0" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="Supports ELM327 adapters via Serial, Bluetooth, and WiFi connections."
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Protocols: ISO 9141-2, KWP2000, SAE J1850, ISO 15765-4 (CAN)"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastUpdateTime, StringFormat='Last update: {0:HH:mm:ss}'}"
                               Foreground="{StaticResource TextDisabledBrush}" FontSize="11" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding PollCount, StringFormat='Polls: {0}'}"
                               Foreground="{StaticResource TextDisabledBrush}" FontSize="11" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding IsSimulationMode, Converter={StaticResource BoolToSimTextConverter}}"
                               FontSize="11" Margin="0,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSimulationMode}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
